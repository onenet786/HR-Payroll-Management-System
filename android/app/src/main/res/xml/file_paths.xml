<?xml version="1.0" encoding="utf-8"?>
<!-- Only what the app shares through its FileProvider: photos taken for an <input type="file"> camera capture, which
     Capacitor's BridgeWebChromeClient writes to getExternalFilesDir(Pictures), and the app's own cache. The whole
     shared storage (external-path ".") is no longer exposed. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="captured_images" path="Pictures/" />
    <cache-path name="my_cache_images" path="." />
</paths>
