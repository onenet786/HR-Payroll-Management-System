# Browser-exposed Firebase web configuration. These are public identifiers, not server secrets.
# Restrictive Firestore Security Rules and Firebase Authentication are mandatory in production.
VITE_FIREBASE_API_KEY=replace_with_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=replace_with_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_with_project_id
VITE_FIREBASE_STORAGE_BUCKET=replace_with_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
VITE_FIREBASE_APP_ID=replace_with_firebase_app_id
VITE_FIRESTORE_DATABASE_ID=replace_with_database_id

# Server/CLI/Electron configuration. Never prefix sensitive server variables with VITE_.
FIREBASE_API_KEY=replace_with_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=replace_with_project.firebaseapp.com
FIREBASE_PROJECT_ID=replace_with_project_id
FIREBASE_STORAGE_BUCKET=replace_with_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
FIREBASE_APP_ID=replace_with_firebase_app_id
FIRESTORE_DATABASE_ID=replace_with_database_id
PORTAL_URL=https://replace-with-your-portal.example

# Server-side only. Present for deployments that enable the corresponding integration.
GEMINI_API_KEY=replace_with_server_side_key
APP_URL=https://replace-with-your-app.example
ALLOWED_ORIGIN=https://replace-with-your-frontend.example
NODE_ENV=production
DEBUG=false
PORT=8080



VITE_FIREBASE_API_KEY=...
VITE_FIREBASE_AUTH_DOMAIN=...
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0314098400
VITE_FIREBASE_STORAGE_BUCKET=...
VITE_FIREBASE_MESSAGING_SENDER_ID=...
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=...
## Runtime data backend (PostgreSQL is the application system of record)
DATA_BACKEND=postgres
DATABASE_URL=postgresql://hr_app:replace_with_strong_password@127.0.0.1:5432/hr_payroll
PG_POOL_MAX=10
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true

## Firebase Admin is used by the server only to verify existing Firebase Authentication tokens.
## Store this value in aaPanel environment settings, never in a committed file.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace_with_project"}
FIRESTORE_DATABASE_ID=(default)

## Browser/mobile API configuration. Leave blank when API and frontend use the same domain.
VITE_API_BASE_URL=
VITE_API_POLL_MS=5000
