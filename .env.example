# PostgreSQL Database Configuration
DATA_BACKEND=postgres
DATABASE_URL=postgresql://hr_app:replace_with_strong_password@127.0.0.1:5432/hr_payroll
PG_POOL_MAX=10
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=false

# Server Runtime Configuration
PORT=8080
HOST=127.0.0.1
NODE_ENV=production
DEBUG=false
ALLOWED_ORIGIN=https://mcs.binishaqsoft.com
APP_URL=https://mcs.binishaqsoft.com
PORTAL_URL=https://mcs.binishaqsoft.com

# Frontend API Configuration
VITE_API_BASE_URL=https://mcs.binishaqsoft.com
VITE_API_POLL_MS=5000

# Server-side payslip email delivery (never expose these as VITE_ variables)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=payroll@example.com
SMTP_PASS=replace_with_app_password
SMTP_FROM="Payroll <payroll@example.com>"

# Encrypted database backups (generate with: openssl rand -base64 32)
BACKUP_ENCRYPTION_KEY=replace_with_32_random_bytes_as_base64
BACKUP_DIR=/var/backups/hr-payroll
BACKUP_RETENTION_COUNT=14
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Authenticator-app MFA (generate with: openssl rand -base64 32)
MFA_ENCRYPTION_KEY=replace_with_separate_32_byte_base64_key
MFA_ISSUER="HR Payroll"
# Optional when PostgreSQL tools are not on PATH
# PG_DUMP_PATH=/usr/bin/pg_dump
# PG_RESTORE_PATH=/usr/bin/pg_restore
