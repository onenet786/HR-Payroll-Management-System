# PostgreSQL Database Configuration
DATA_BACKEND=postgres
DATABASE_URL=postgresql://hr_app:replace_with_strong_password@127.0.0.1:5432/hr_payroll
PG_POOL_MAX=10
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=false

# Server Runtime Configuration
PORT=8080
HOST=127.0.0.1
NODE_ENV=production
DEBUG=false
ALLOWED_ORIGIN=https://attendance.binishaqsoft.com
APP_URL=https://attendance.binishaqsoft.com
PORTAL_URL=https://attendance.binishaqsoft.com

# Frontend API Configuration
VITE_API_BASE_URL=https://attendance.binishaqsoft.com
VITE_API_POLL_MS=5000

# Server-side payslip email delivery (never expose these as VITE_ variables)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=payroll@example.com
SMTP_PASS=replace_with_app_password
SMTP_FROM="Payroll <payroll@example.com>"

# Optional SMS / WhatsApp salary alerts (server-side only; leave blank to disable).
# Alerts say only that the salary was processed — never amounts, CNIC or bank details.
# SMS via Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# WhatsApp via Twilio (sender number approved for WhatsApp):
TWILIO_WHATSAPP_FROM=
# ...or SMS via a local aggregator that accepts POST {to, from, text} JSON with a bearer token:
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_HTTP_SENDER=
# WhatsApp Business Cloud API (takes precedence over Twilio WhatsApp). The template must be approved
# by Meta with two body parameters: {{1}} employee first name, {{2}} pay period (MM/YYYY).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Encrypted database backups (generate with: openssl rand -base64 32)
BACKUP_ENCRYPTION_KEY=replace_with_32_random_bytes_as_base64
BACKUP_DIR=/var/backups/hr-payroll
BACKUP_RETENTION_COUNT=14
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Authenticator-app MFA (generate with: openssl rand -base64 32)
MFA_ENCRYPTION_KEY=replace_with_separate_32_byte_base64_key
MFA_ISSUER="HR Payroll"

# Private server-only directory for CNIC scans, contracts and employee documents.
# Never place this inside the public web root or dist directory.
DOCUMENT_STORAGE_PATH=/var/lib/hr-payroll/private-documents
# Set true only after every administrator and payroll/access user has enrolled MFA.
MFA_ENFORCE_PRIVILEGED=false
# Optional when PostgreSQL tools are not on PATH
# PG_DUMP_PATH=/usr/bin/pg_dump
# PG_RESTORE_PATH=/usr/bin/pg_restore
