# OneNet Provider Console — copy to provider/.env (chmod 600). See docs/OneNet-Provider-Console-Hosting-Guide.pdf.

NODE_ENV=production
PROVIDER_PORT=8200
PROVIDER_HOST=127.0.0.1
PROVIDER_PUBLIC_URL=https://admin.binishaqsoft.com
PROVIDER_SESSION_HOURS=12

# The console's own database (create it in aaPanel → Databases → PgSQL).
PROVIDER_DATABASE_URL=postgresql://provider:CHANGE_ME@127.0.0.1:5432/hr_provider
# PostgreSQL administrator: creates each client's role and database (aaPanel PgSQL root/postgres account).
PG_ADMIN_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres
# Folder with pg_dump / pg_restore of the server's PostgreSQL version (written into each client's .env).
PG_BIN_DIR=/www/server/pgsql/bin
TEMPLATE_DB=hr_template

# Encrypts provider authenticator secrets and one-time passwords (32 random bytes, base64: openssl rand -base64 32).
MFA_ENCRYPTION_KEY=

# Hosting layout
BASE_DOMAIN=binishaqsoft.com
SERVER_IP=203.0.113.10
# Only if you offer nameserver delegation for dedicated client domains (e.g. your Cloudflare nameservers).
PROVIDER_NAMESERVERS=
CLIENTS_ROOT=/www/hr-clients
RELEASES_ROOT=/www/hr-releases
BACKUP_ROOT=/www/hr-backups
CLIENT_PORT_START=9101

# aaPanel API (aaPanel → Settings → API interface: enable, whitelist 127.0.0.1 and this server's IP)
AAPANEL_URL=https://127.0.0.1:7800
AAPANEL_API_KEY=
AAPANEL_INSECURE_TLS=true
AAPANEL_NODE_VERSION=v20.18.0
AAPANEL_RUN_USER=www

# Wildcard certificate *.BASE_DOMAIN issued once in aaPanel (DNS validation); paths to its files
WILDCARD_CERT_PATH=/www/server/panel/vhost/cert/binishaqsoft.com/fullchain.pem
WILDCARD_KEY_PATH=/www/server/panel/vhost/cert/binishaqsoft.com/privkey.pem

# Default outgoing mail copied into each new client's .env (clients can be changed later)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
