{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/sync-face-models.cjs",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "node scripts/sync-face-models.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 server/documents.integration.cjs server/payroll-alerts.integration.cjs server/vault-email.integration.cjs server/auth-session.integration.cjs server/trusted-device.integration.cjs server/kiosk.integration.cjs server/user-secrets.integration.cjs server/reports.integration.cjs server/db-maintenance.integration.cjs",
    "docs:build": "node scripts/generate-user-guide-docx.mjs",
    "docs:pdf": "node scripts/build-complete-pdf-guide.mjs",
    "postgres:migrate": "node scripts/postgres-migrate.cjs",
    "postgres:seed": "node scripts/seed-local-db.cjs",
    "seed:demo": "node scripts/seed-demo-workflow.cjs",
    "seed:demo:build": "esbuild scripts/seed-demo-workflow.ts --bundle --platform=node --target=node20 --format=cjs --external:pg --external:bcryptjs --external:dotenv --outfile=scripts/seed-demo-workflow.cjs",
    "postgres:backup": "node scripts/postgres-backup.cjs",
    "postgres:backup:verify": "node scripts/postgres-backup-verify.cjs",
    "postgres:restore": "node scripts/postgres-restore.cjs",
    "server:bundle": "node deploy/installer/build-bundle.mjs",
    "docs:setup-guide": "node deploy/installer/build-setup-guide.mjs",
    "docs:migration-guide": "node deploy/installer/build-migration-guide.mjs",
    "docs:provider-guides": "node deploy/installer/build-provider-guides.mjs",
    "docs:windows-guide": "node deploy/windows/build-windows-guide.mjs",
    "docs:database-commands": "node deploy/windows/build-database-commands-guide.mjs",
    "windows:server-bundle": "node deploy/windows/build-windows-guide.mjs && node deploy/windows/build-windows-bundle.mjs",
    "legacy:import": "node scripts/cyberap-import.cjs",
    "test:legacy-import": "node --test server/legacy-import/cyberap.test.cjs",
    "provider:build": "vite build --config provider/vite.config.ts",
    "provider:dev": "vite --config provider/vite.config.ts",
    "provider:start": "node provider/server.cjs",
    "provider:migrate": "node provider/cli.cjs migrate",
    "test:provider": "node --test provider/test/*.test.cjs server/installation.test.cjs",
    "windows:run": "npm run build && electron .",
    "windows:build": "npm run build && electron-builder --win",
    "prekiosk:run": "node scripts/sync-face-models.cjs",
    "kiosk:run": "electron windows-kiosk/main.cjs",
    "prekiosk:build": "node scripts/sync-face-models.cjs && node scripts/bump-kiosk-version.cjs",
    "kiosk:build": "node scripts/electron-builder-retry.cjs --config windows-kiosk/electron-builder.json --win"
  },
  "build": {
    "appId": "com.binishaq.hrsuite",
    "productName": "HR & Payroll Suite",
    "icon": "assets/icon.png",
    "directories": {
      "output": "dist-windows"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "tools/uru4500-bridge/bin",
        "to": "uru4500-bridge",
        "filter": [
          "URU4500Bridge.exe",
          "DPUruNet.dll",
          "dpfj.dll",
          "dpfpdd.dll",
          "dpfpdd_4k.dll",
          "SecuGen.FDxSDKPro.Windows.dll",
          "sgfplib.dll"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "@vladmandic/face-api": "1.7.15",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.1.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "docx": "^9.7.1",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
